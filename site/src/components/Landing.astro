---
// The home page under the hero and its lead: the picker.
import Picker from './Picker.astro';
---
<div class="cd-landing not-content">
	<Picker />
</div>

<style>
	.cd-landing {
		display: grid;
		gap: 2.5rem;
		max-width: 64rem;
		margin: 0 auto;
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		overflow-wrap: anywhere;
	}
	.cd-landing :global(.cd-picker) {
		margin: 0;
	}
</style>
