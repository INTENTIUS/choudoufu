---
// The site title: the cube and the "choudoufu" wordmark, linking home. It is
// drawn here rather than through Starlight's `logo` option because that option
// imports the image at build time, and the logo files arrive in their own PR;
// a URL reference lets the build pass before they land.
//
// On a phone a Docs link sits beside it: Starlight hides the header's right
// side (where SocialIcons.astro puts Docs) below its md width.
// Adapted from terragucci's docs-site.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="site-title sl-flex">
	<img src={`${base}/brand/cube.svg`} width="32" height="32" alt="" />
	<span translate="no">choudoufu</span>
</a>
<a class="cd-docs-phone" href={`${base}/docs/use/start/`}>Docs</a>

<style>
	.site-title {
		align-items: center;
		gap: var(--sl-nav-gap);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.site-title img {
		width: 32px;
		height: 32px;
		image-rendering: pixelated;
	}
	.cd-docs-phone {
		align-self: center;
		margin-left: 0.75rem;
		padding: 0.2rem 0.65rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-white);
		text-decoration: none;
		border: 1px solid var(--cd-rule);
		border-radius: 999px;
		white-space: nowrap;
	}
	@media (min-width: 50rem) {
		.cd-docs-phone {
			display: none;
		}
	}
</style>
