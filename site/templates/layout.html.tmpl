<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{if eq .Title "choudoufu"}}choudoufu{{else}}{{.Title}} - choudoufu{{end}}</title>
<link rel="stylesheet" href="{{.AssetPrefix}}style.css?v={{.CSSVersion}}">
<link rel="icon" href="{{.AssetPrefix}}favicon.ico" sizes="48x48 32x32 16x16">
<link rel="icon" type="image/png" sizes="16x16" href="{{.AssetPrefix}}choudoufu-favicon-16.png">
<link rel="icon" type="image/png" sizes="32x32" href="{{.AssetPrefix}}choudoufu-favicon-32.png">
<link rel="icon" type="image/png" sizes="48x48" href="{{.AssetPrefix}}choudoufu-favicon-48.png">
</head>
<body>
<header class="site-header">
  <a class="brand" href="{{.AssetPrefix}}index.html">choudoufu</a>
  <nav>
    {{range .Nav}}<a href="{{$.AssetPrefix}}{{.Href}}"{{if .Active}} class="active"{{end}}>{{.Label}}</a>{{end}}
  </nav>
</header>
<main>
{{.Content}}
</main>
<div class="site-hero-image">
  <img src="{{.AssetPrefix}}choudoufu-hero.png" alt="a plate of choudoufu" width="1024" height="1024">
</div>
<footer class="site-footer">
  <p>choudoufu is an independent fork. It is not affiliated with or endorsed
  by OpenTofu or the Linux Foundation. OpenTofu is a registered trademark of
  the Linux Foundation. Code is licensed MPL-2.0. Upstream source lives at
  <a href="https://github.com/opentofu/opentofu">github.com/opentofu/opentofu</a>
  and all stock docs at
  <a href="https://opentofu.org/docs/">opentofu.org/docs</a>.</p>
</footer>
</body>
</html>
