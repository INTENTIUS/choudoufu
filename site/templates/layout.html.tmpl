<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{if eq .Title "choudoufu"}}choudoufu{{else}}{{.Title}} - choudoufu{{end}}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap">
<link rel="stylesheet" href="{{.AssetPrefix}}style.css?v={{.CSSVersion}}">
<link rel="icon" href="{{.AssetPrefix}}favicon.ico?v={{.AssetVersion}}" sizes="48x48 32x32 16x16">
<link rel="icon" type="image/png" sizes="16x16" href="{{.AssetPrefix}}choudoufu-favicon-16.png?v={{.AssetVersion}}">
<link rel="icon" type="image/png" sizes="32x32" href="{{.AssetPrefix}}choudoufu-favicon-32.png?v={{.AssetVersion}}">
<link rel="icon" type="image/png" sizes="48x48" href="{{.AssetPrefix}}choudoufu-favicon-48.png?v={{.AssetVersion}}">
</head>
<body>
<header class="site-header">
  <a class="brand" href="{{.AssetPrefix}}index.html">
    <img src="{{.AssetPrefix}}choudoufu-inline-64.png?v={{.AssetVersion}}" alt="" width="28" height="28">
    choudoufu
  </a>
  <nav>
    <a href="{{.AssetPrefix}}index.html">Home</a>
    <a href="{{.AssetPrefix}}faq.html">Docs</a>
    <a href="https://opentofu.org/docs/">OpenTofu Docs</a>
    <a href="https://github.com/INTENTIUS/choudoufu">GitHub</a>
  </nav>
</header>
{{if .Sidebar}}
<div class="docs-shell">
  <aside class="sidebar">
    {{range .Sidebar}}
    <p class="sidebar-heading">{{.Title}}</p>
    <ul>
      {{range .Items}}<li>{{if .Soon}}<span class="soon">{{.Label}} <em>soon</em></span>{{else}}<a href="{{$.AssetPrefix}}{{.Href}}"{{if .Active}} class="active" aria-current="page"{{end}}>{{.Label}}</a>{{end}}</li>
      {{end}}
    </ul>
    {{end}}
  </aside>
  <main class="doc-card">
{{.Content}}
  </main>
</div>
{{else}}
<main class="landing">
{{.Content}}
</main>
<div class="site-hero-image">
  <img src="{{.AssetPrefix}}choudoufu-hero.png?v={{.AssetVersion}}" alt="a plate of choudoufu" width="1024" height="1024">
</div>
{{end}}
<footer class="site-footer">
  <p>choudoufu is an independent fork. It is not affiliated with or endorsed
  by OpenTofu or the Linux Foundation. OpenTofu is a registered trademark of
  the Linux Foundation. Code is licensed MPL-2.0. Upstream source lives at
  <a href="https://github.com/opentofu/opentofu">github.com/opentofu/opentofu</a>
  and all stock docs at
  <a href="https://opentofu.org/docs/">opentofu.org/docs</a>.</p>
</footer>
</body>
</html>
