---
// A slot page's link to the same slot on the other platform: AWS adopt to
// Kubernetes adopt and back. The page's own id decides both sides, so a slot
// page places <PlatformSwitch /> with no props.
const id = Astro.locals.starlightRoute.entry.id;
const [platform, slot] = id.split('/');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sides = [
	{ key: 'aws', label: 'AWS' },
	{ key: 'kubernetes', label: 'Kubernetes' },
];
---
<p class="cd-switch not-content">
	{sides.map((s) =>
		s.key === platform ? (
			<span aria-current="page">{s.label}</span>
		) : (
			<a href={`${base}/${s.key}/${slot}/`}>{s.label}</a>
		),
	)}
</p>

<style>
	.cd-switch {
		display: inline-flex;
		gap: 0.25rem;
		margin: 0 0 1rem;
		padding: 0.15rem;
		font-size: var(--sl-text-sm);
		border: 1px solid var(--cd-rule);
		border-radius: 0.45rem;
	}
	span,
	a {
		padding: 0.1rem 0.6rem;
		border-radius: 0.3rem;
	}
	span {
		font-weight: 600;
		color: var(--sl-color-black);
		background: var(--cd-accent);
	}
	a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	a:hover {
		color: var(--sl-color-white);
	}
</style>
