{
  "schema": 1,
  "store": "s3",
  "description": "chant#4558 shared bucket fixtures, S3. Each case is what GetBucketVersioning, GetBucketLifecycleConfiguration and GetPublicAccessBlock answered, in the S3 API's own field names (aws-sdk-go-v2 output types decode them as-is), or {\"error\": {\"code\", \"status\"}} for a failed read. expect lists one verdict per setting in order: versioning, lifecycle, public_access_block. Verdicts are choudoufu live-bucket -json's: ok, fail, unreadable. namespaces are the object-key prefixes the estate or stack writes under.",
  "cases": [
    {
      "name": "correct-unfiltered-rule",
      "bucket": "records-prod",
      "namespaces": ["records/prod"],
      "input": {
        "versioning": { "Status": "Enabled" },
        "lifecycle": { "Rules": [{ "ID": "noncurrent", "Status": "Enabled", "Filter": {}, "NoncurrentVersionExpiration": { "NoncurrentDays": 30 } }] },
        "publicAccessBlock": { "PublicAccessBlockConfiguration": { "BlockPublicAcls": true, "IgnorePublicAcls": true, "BlockPublicPolicy": true, "RestrictPublicBuckets": true } }
      },
      "expect": [
        { "setting": "versioning", "verdict": "ok", "unwaivable": false },
        { "setting": "lifecycle", "verdict": "ok", "unwaivable": false },
        { "setting": "public_access_block", "verdict": "ok", "unwaivable": false }
      ]
    },
    {
      "name": "bare-bucket",
      "bucket": "records-prod",
      "namespaces": ["records/prod"],
      "input": {
        "versioning": {},
        "lifecycle": { "error": { "code": "NoSuchLifecycleConfiguration", "status": 404 } },
        "publicAccessBlock": { "error": { "code": "NoSuchPublicAccessBlockConfiguration", "status": 404 } }
      },
      "expect": [
        { "setting": "versioning", "verdict": "fail", "unwaivable": false },
        { "setting": "lifecycle", "verdict": "fail", "unwaivable": false },
        { "setting": "public_access_block", "verdict": "fail", "unwaivable": false }
      ]
    },
    {
      "name": "versioning-suspended",
      "bucket": "records-prod",
      "namespaces": ["records/prod"],
      "input": {
        "versioning": { "Status": "Suspended" },
        "lifecycle": { "Rules": [{ "ID": "noncurrent", "Status": "Enabled", "Filter": {}, "NoncurrentVersionExpiration": { "NoncurrentDays": 30 } }] },
        "publicAccessBlock": { "PublicAccessBlockConfiguration": { "BlockPublicAcls": true, "IgnorePublicAcls": true, "BlockPublicPolicy": true, "RestrictPublicBuckets": true } }
      },
      "expect": [
        { "setting": "versioning", "verdict": "fail", "unwaivable": false },
        { "setting": "lifecycle", "verdict": "ok", "unwaivable": false },
        { "setting": "public_access_block", "verdict": "ok", "unwaivable": false }
      ]
    },
    {
      "name": "prefix-rule-contains-namespace",
      "bucket": "shared-state",
      "namespaces": ["records/prod"],
      "input": {
        "versioning": { "Status": "Enabled" },
        "lifecycle": { "Rules": [{ "ID": "records-noncurrent", "Status": "Enabled", "Filter": { "Prefix": "records/" }, "NoncurrentVersionExpiration": { "NoncurrentDays": 14 } }] },
        "publicAccessBlock": { "PublicAccessBlockConfiguration": { "BlockPublicAcls": true, "IgnorePublicAcls": true, "BlockPublicPolicy": true, "RestrictPublicBuckets": true } }
      },
      "expect": [
        { "setting": "versioning", "verdict": "ok", "unwaivable": false },
        { "setting": "lifecycle", "verdict": "ok", "unwaivable": false },
        { "setting": "public_access_block", "verdict": "ok", "unwaivable": false }
      ]
    },
