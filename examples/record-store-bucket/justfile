# The record store bucket: `just up`, `just verify`, `just down`.
# `just` lists everything. GitHub issue #1341.
set shell := ["bash", "-euo", "pipefail", "-c"]

region := env_var_or_default("AWS_REGION", "us-east-2")

default:
    @just --list

# Install the chant project's dependencies.
install:
    npm install

# The bucket name. Globally unique, so it is derived from the account rather
# than guessed - the same account that will hold the estate. Any name works;
# pass one to any recipe below and nothing assumes the derived shape.
_bucket:
    #!/usr/bin/env bash
    set -euo pipefail
    acct=$(aws sts get-caller-identity --query Account --output text)
    echo "choudoufu-records-${acct}-{{region}}"

# The choudoufu binary `verify` asks. CHOUDOUFU_BIN, then PATH, then built
# from this checkout - the same order the smoke stack resolves it in.
_choudoufu:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -n "${CHOUDOUFU_BIN:-}" ]; then echo "$CHOUDOUFU_BIN"; exit 0; fi
    if command -v choudoufu >/dev/null 2>&1; then command -v choudoufu; exit 0; fi
    root="$(cd ../.. && pwd)"
    command -v go >/dev/null 2>&1 || { echo "no choudoufu on PATH, CHOUDOUFU_BIN unset, and no Go to build one from $root" >&2; exit 1; }
    mkdir -p .bin
    ( cd "$root" && go build -o "$OLDPWD/.bin/choudoufu" ./cmd/choudoufu ) >&2
    echo "$PWD/.bin/choudoufu"

# The retention window to build with. An explicit RECORD_NONCURRENT_DAYS wins.
# Otherwise, if the bucket already exists, whatever it has NOW - so running
# `up` again never resets a window somebody has since changed. Otherwise 30.
#
# Exactly two failures mean "there is no window to preserve": the bucket is
# not there, and it has no lifecycle configuration. A throttle, an expired
# session and AccessDenied are reads that did not happen, and the old
# `2>/dev/null || true` turned all of them into 30, which is how a window
# somebody chose on purpose gets reset by the next `up`. Those stop the run.
#
# The candidate rule is an ENABLED one with no filter (or an empty prefix),
# which is the same shape choudoufu's bucket contract counts. Taking the
# first rule with any NoncurrentDays read a disabled rule, or a rule filtered
# to one prefix, as if it were this bucket's window.
_days bucket:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -n "${RECORD_NONCURRENT_DAYS:-}" ]; then echo "$RECORD_NONCURRENT_DAYS"; exit 0; fi
    err=$(mktemp); trap 'rm -f "$err"' EXIT
    if ! live=$(aws s3api get-bucket-lifecycle-configuration --bucket "{{bucket}}" --output json 2>"$err"); then
      msg=$(cat "$err")
      case "$msg" in
        *NoSuchBucket*|*NoSuchLifecycleConfiguration*) echo 30; exit 0 ;;
      esac
      echo "Could not read {{bucket}}'s lifecycle configuration:" >&2
      echo "$msg" >&2
      echo "That is not the same as the bucket having no retention window, and building with the" >&2
      echo "30 day default here would reset a window somebody chose. Fix the error above, or pass" >&2
      echo "RECORD_NONCURRENT_DAYS to say what the window should be." >&2
      exit 1
    fi
    cands=$(jq -c '
      def unfiltered:
        ((.Prefix // "") == "")
        and ((.Filter // {}) | to_entries | map(select(.value != null))
             | all(.key == "Prefix" and (.value == "")));
      [ .Rules[]?
        | select(.Status == "Enabled")
        | select(.NoncurrentVersionExpiration.NoncurrentDays != null)
        | select(unfiltered)
        | {id: (.ID // .Id // "(no id)"), days: .NoncurrentVersionExpiration.NoncurrentDays} ]' <<< "$live")
    n=$(jq 'length' <<< "$cands")
    case "$n" in
      0) echo 30; exit 0 ;;
      1) ;;
      *) echo "{{bucket}} has $n enabled rules that expire noncurrent versions and reach every key:" >&2
         jq -r '.[] | "  \(.id): \(.days) day(s)"' <<< "$cands" >&2
         echo "Which of those is the bucket's recovery window is not a guess this recipe should" >&2
         echo "make. Pass RECORD_NONCURRENT_DAYS, or leave one such rule on the bucket." >&2
         exit 1 ;;
    esac
    days=$(jq -r '.[0].days' <<< "$cands")
    case "$days" in
      ''|*[!0-9]*) echo "{{bucket}}'s retention window read as \"$days\", which is not a number of days." >&2; exit 1 ;;
    esac
    echo "$days"

# The KMS key the LIVE bucket encrypts with, or nothing. Read the same way as
# `_days`, and absent for the same two reasons only: no bucket, and no
# encryption configuration on it.
_livekey bucket:
    #!/usr/bin/env bash
    set -euo pipefail
    err=$(mktemp); trap 'rm -f "$err"' EXIT
    if ! live=$(aws s3api get-bucket-encryption --bucket "{{bucket}}" --output json 2>"$err"); then
      msg=$(cat "$err")
      case "$msg" in
        *NoSuchBucket*|*ServerSideEncryptionConfigurationNotFoundError*) echo ""; exit 0 ;;
      esac
      echo "Could not read {{bucket}}'s default encryption:" >&2
      echo "$msg" >&2
      echo "A failed read is not the same as a bucket with no key, and the difference decides" >&2
      echo "whether this run would drop the key's Deny statements. Fix the error above." >&2
      exit 1
    fi
    # .Rules[], not []?: GetBucketEncryption answers with an OBJECT whose one
    # field is Rules. Iterating the object yields that array, and indexing an
    # array by name is a jq error, which `set -e` turned into a dead `up` on
    # every real KMS bucket - refusing nothing, naming nothing (#1421).
    jq -r '[.ServerSideEncryptionConfiguration.Rules[]?
            | select(.ApplyServerSideEncryptionByDefault.SSEAlgorithm == "aws:kms")
            | .ApplyServerSideEncryptionByDefault.KMSMasterKeyID // ""]
           | map(select(. != "")) | .[0] // ""' <<< "$live"

# Build the CloudFormation template from the lexicon declaration.
_build bucket:
    #!/usr/bin/env bash
    set -euo pipefail
    days=$(just _days "{{bucket}}")
    RECORD_BUCKET="{{bucket}}" RECORD_NONCURRENT_DAYS="$days" npx chant build src --lexicon aws -o templates/template.json >/dev/null
    echo "$days"

# What standing it up would do: the template, built from the declaration.
plan bucket="":
    #!/usr/bin/env bash
    set -euo pipefail
    b="{{bucket}}"; [ -n "$b" ] || b=$(just _bucket)
    just _build "$b" >/dev/null
    cat templates/template.json

# Create or update the bucket, and print RECORD_STORE_BUCKET. Safe to run twice.
up bucket="":
    #!/usr/bin/env bash
    set -euo pipefail
    b="{{bucket}}"; [ -n "$b" ] || b=$(just _bucket)

    # `up` preserves the retention window it finds on the live bucket. The key
    # is the same kind of decision and gets the same treatment. Without this,
    # a second `up` with RECORD_KMS_KEY_ARN unset rebuilt the bucket as SSE-S3
    # and dropped both KMS Deny statements from the bucket policy, and the
    # only sign of it was a diff in the changeset nobody reads.
    live_key=$(just _livekey "$b")
    want="${RECORD_KMS_KEY_ARN:-}"
    if [ -n "$live_key" ] && [ "$live_key" != "$want" ]; then
      echo "REFUSING to update $b." >&2
      echo "Its default encryption is SSE-KMS under:" >&2
      echo "  $live_key" >&2
      if [ -z "$want" ]; then
        echo "RECORD_KMS_KEY_ARN is unset, so this run would rebuild the bucket with S3-managed" >&2
        echo "encryption and drop the two Deny statements that keep a put off any other key." >&2
      else
        echo "RECORD_KMS_KEY_ARN names a different key:" >&2
        echo "  $want" >&2
        echo "so this run would repoint the default encryption and both Deny statements at it." >&2
      fi
      echo "Objects already written stay under the key that encrypted them either way, so a run" >&2
      echo "that changes this by accident leaves a bucket whose policy and whose objects disagree." >&2
      echo >&2
      echo "To keep the key it has, which is what running up again usually means:" >&2
      echo "  RECORD_KMS_KEY_ARN=$live_key just up $b" >&2
      echo "To move to another key on purpose, name that key the same way, and give the estate" >&2
      echo "roles access to both keys until nothing is left under the old one." >&2
      echo "To go back to S3-managed encryption on purpose there is no flag, deliberately: change" >&2
      echo "the bucket first and run up again, which will then agree with it." >&2
      echo "  aws s3api put-bucket-encryption --bucket $b --region {{region}} \\" >&2
      echo "    --server-side-encryption-configuration '{\"Rules\":[{\"ApplyServerSideEncryptionByDefault\":{\"SSEAlgorithm\":\"AES256\"}}]}'" >&2
      exit 1
    fi

    days=$(just _build "$b")
    aws cloudformation deploy \
      --template-file templates/template.json \
      --stack-name "$b" \
      --region "{{region}}" \
      --no-fail-on-empty-changeset
    echo
    echo "RECORD_STORE_BUCKET=$b"
    echo "noncurrent versions expire after ${days} day(s): that is how long a record destroyed by mistake stays recoverable."

# Is this bucket correct? Asks the choudoufu binary; nothing here re-checks.
verify bucket="":
    #!/usr/bin/env bash
    set -euo pipefail
    b="{{bucket}}"; [ -n "$b" ] || b=$(just _bucket)
    bin=$(just _choudoufu)
    fail=0

    # The three asserted settings. This is choudoufu's own answer, and it
    # reports the BUCKET: an allow_insecure waiver in some estate's
    # configuration changes whether that estate's runs proceed, never this.
    "$bin" live-bucket -bucket="$b" -region="{{region}}" || fail=1

    # The customer managed key, when this bucket was stood up with one. These
    # test the POLICY, which is not one of the three assertions and which
    # choudoufu has no opinion on, so they are not a second copy of anything.
    #
    # They are a set rather than a check each. An earlier version ran only
    # the first, against a policy that denied on StringNotEquals alone. It
    # passed, and the policy was broken in the way that matters: it denied the
    # header-less PutObject the record store actually issues. A check that
    # only proves a Deny fires cannot tell a correct policy from one that
    # refuses everything.
    if [ -n "${RECORD_KMS_KEY_ARN:-}" ]; then
      say() { printf '  %-42s %s\n' "$1" "$2"; }
      tmp=$(mktemp)
      if aws s3api put-object --bucket "$b" --key "_verify/aes256" --body "$tmp" \
           --server-side-encryption AES256 >/dev/null 2>&1; then
        say "explicit AES256 PUT refused" "FAIL - it was accepted"; fail=1
      else
        say "explicit AES256 PUT refused" "ok"
      fi
      if aws s3api put-object --bucket "$b" --key "_verify/default" --body "$tmp" >/dev/null 2>&1; then
        say "header-less PUT accepted" "ok"
      else
        say "header-less PUT accepted" "FAIL - the record store cannot write"; fail=1
      fi
      gotkey=$(aws s3api head-object --bucket "$b" --key "_verify/default" --query 'SSEKMSKeyId' --output text 2>/dev/null || echo NONE)
      if [ "$gotkey" = "$RECORD_KMS_KEY_ARN" ]; then
        say "header-less PUT landed under your key" "ok"
      else
        say "header-less PUT landed under your key" "FAIL (key=$gotkey)"; fail=1
      fi
      rm -f "$tmp"
    fi
    exit "$fail"

# The IAM policy for one estate's role against this bucket. Pass the rest of
# render-policy.sh's flags through: --kms <key-arn>, --reads-outputs-of <estate>.
# This is the documentation's policy, from the same script; the bucket policy
# above grants nobody anything.
policy estate bucket="" *flags="":
    #!/usr/bin/env bash
    set -euo pipefail
    b="{{bucket}}"; [ -n "$b" ] || b=$(just _bucket)
    ./iam/render-policy.sh "{{estate}}" "$b" {{flags}}

# The statement your key's KEY POLICY needs, naming who may use the key: the
# estate roles, and whoever would recover a deleted record. One statement,
# to add to a policy that is otherwise yours.
key-statement +principals:
    ./iam/render-key-statement.sh {{principals}}

# A broken Op should fail here rather than the first time somebody reaches
# for the approval gate.

# Prove the Ops resolve and lint.
ops bucket="":
    #!/usr/bin/env bash
    set -euo pipefail
    b="{{bucket}}"; [ -n "$b" ] || b=$(just _bucket)
    RECORD_BUCKET="$b" npx chant list src
    RECORD_BUCKET="$b" npx chant lint src

# Governed path: plan through the Op. Read-only, touches no account.
chant-plan bucket="":
    #!/usr/bin/env bash
    set -euo pipefail
    b="{{bucket}}"; [ -n "$b" ] || b=$(just _bucket)
    RECORD_BUCKET="$b" npx chant run bucket-plan

# Governed path: apply through the Op, stopping at its approval gate.
chant-apply bucket="":
    #!/usr/bin/env bash
    set -euo pipefail
    b="{{bucket}}"; [ -n "$b" ] || b=$(just _bucket)
    RECORD_BUCKET="$b" npx chant run bucket-apply

# Tear down what `up` created and nothing else; refuses while the bucket holds any object version.
down bucket="":
    #!/usr/bin/env bash
    set -euo pipefail
    b="{{bucket}}"; [ -n "$b" ] || b=$(just _bucket)

    # Every VERSION in the WHOLE bucket. Both halves are load-bearing.
    #
    # Versions, because a deleted record is a delete marker over a noncurrent
    # version that is still recoverable, and the bucket is the only place it
    # can be recovered from. A count of current objects reads that as empty.
    #
    # The whole bucket rather than `tofu-`, because an estate with a
    # `key_prefix` override writes its records somewhere else entirely
    # (`team/prod/...`), and a count under `tofu-` read that bucket as empty
    # too. This bucket exists to hold records, so anything in it that is not
    # one of `verify`'s own `_verify/` probes is something somebody would
    # miss.
    #
    # --output json through jq, not --query 'length(...)' --output text: the
    # CLI applies --query PER PAGE under text output, so a bucket past one
    # page printed one count per line, both `[ "$x" -gt 0 ]` tests errored
    # with "integer expression expected", the `if` read false and the
    # teardown proceeded. Same bug as issue #1047, written up at
    # live/live-cert/lib/live-cert.sh's livecert_rgta_count. Under --output
    # json the CLI merges every page before the query runs, and jq counts the
    # merged result.
    held=$(aws s3api list-object-versions --bucket "$b" --output json \
      --query '{Versions: Versions[].Key, DeleteMarkers: DeleteMarkers[].Key}')
    keys=$(jq -c '[(.Versions // [])[], (.DeleteMarkers // [])[]] | map(select(startswith("_verify/") | not))' <<< "$held" 2>/dev/null || true)
    count=$(jq 'length' <<< "$keys" 2>/dev/null || true)
    # A count that is not a whole number is not a zero. Whatever produced it,
    # it is not evidence that the bucket is empty, and this check is the only
    # thing between a teardown and the one copy of an estate's identity.
    case "$count" in
      ''|*[!0-9]*)
        echo "REFUSING to tear down $b." >&2
        echo "Counting the object versions in it produced \"$count\", which is not a count." >&2
        echo "Nothing here can tell an empty bucket from one that was never read, so nothing" >&2
        echo "is deleted. The raw answer was:" >&2
        echo "$held" >&2
        exit 1 ;;
    esac
    if [ "$count" -gt 0 ]; then
      echo "REFUSING to tear down $b." >&2
      echo "It holds $count object version(s) and delete marker(s) outside _verify/:" >&2
      jq -r 'map(if test("/") then sub("/.*$"; "/") else . end) | group_by(.)
             | map("  \(.[0])  \(length)") | .[]' <<< "$keys" >&2
      echo "For a record-backed resource the record is the ONLY copy of the estate's identity for it:" >&2
      echo "it carries no marker and cannot be imported under a live block. Destroying this bucket" >&2
      echo "destroys those identities, and the recovery copies of any already deleted." >&2
      echo >&2
      echo "A destroyed estate does not empty its prefixes. choudoufu destroy deletes the resources" >&2
      echo "and writes a tombstone envelope over each identity record, and it leaves that envelope," >&2
      echo "the estate's sentinel, its hint and every tofu-outputs/ object behind as CURRENT objects." >&2
      echo "No lifecycle rule removes a current object here, on purpose: expiring one would delete an" >&2
      echo "identity for a resource that still exists. The rule expires superseded VERSIONS, and" >&2
      echo "clears a delete marker once nothing is left under it." >&2
      echo "So emptying these prefixes is a deliberate step, and it is yours:" >&2
      jq -r --arg b "$b" 'map(if test("/") then sub("/.*$"; "/") else . end) | unique
             | map("  aws s3 rm \"s3://\($b)/\(.)\" --recursive") | .[]' <<< "$keys" >&2
      echo "Each of those writes a delete marker over what it deletes, so this recipe keeps" >&2
      echo "refusing until those versions and markers age out on the bucket's own window." >&2
      exit 1
    fi
    # `verify` may have left its own probe objects. Nothing else is touched:
    # if you put anything else here, CloudFormation refuses a non-empty bucket
    # and says so, which is the right outcome.
    probes=$(aws s3api list-object-versions --bucket "$b" --prefix "_verify/" \
      --query '{Objects: [Versions, DeleteMarkers][] | [?@ != `null`] | [].{Key:Key,VersionId:VersionId}}' --output json)
    if [ "$(jq '.Objects | length' <<< "$probes")" -gt 0 ]; then
      aws s3api delete-objects --bucket "$b" --delete "$probes" >/dev/null
    fi
    aws cloudformation delete-stack --stack-name "$b" --region "{{region}}"
    aws cloudformation wait stack-delete-complete --stack-name "$b" --region "{{region}}"

    # Not "gone". The bucket carries DeletionPolicy and UpdateReplacePolicy
    # Retain, so CloudFormation releases it from the stack instead of deleting
    # it, and saying otherwise here would send somebody away believing an
    # empty account. The bucket policy is a separate resource without Retain
    # and goes with the stack, which is why the last line below matters: what
    # is left is a bucket nobody's IAM has been granted, and an unpolicied one.
    echo "stack deleted: $b"
    echo "bucket RETAINED on purpose: $b"
    echo
    echo "Retain is what keeps a stack operation from being able to destroy records: a bucket"
    echo "CloudFormation may not delete cannot be deleted by a rollback, a rename or a mistake"
    echo "in this recipe. The cost is that removing the bucket is now its own decision, and"
    echo "that a later 'just up' under this name cannot recreate the stack until the bucket is gone."
    echo "It is empty (this recipe refuses while it is not). Two commands remove it:"
    echo "  aws s3api list-object-versions --bucket $b --region {{region}} --max-items 1"
    echo "  aws s3api delete-bucket --bucket $b --region {{region}}"
    echo "The first is the look before the second: expect an empty answer, then delete."
    echo "The stack took the bucket policy with it, so until then the bucket denies nothing"
    echo "by policy and is reachable by whatever IAM already reaches it."
