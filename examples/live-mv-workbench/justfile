# live-mv demo — two containers, one command. `just` lists everything.
set shell := ["bash", "-euo", "pipefail", "-c"]
compose := "docker compose -f compose/docker-compose.yml"
# The release version this example is measured against, read from the one
# place it is declared (tlmig/config.py) so the image's default pin cannot
# drift from it silently.
pinned_version := `grep -m1 '^CHOUDOUFU_VERSION' tlmig/config.py | sed -E 's/.*"(.*)".*/\1/'`

default:
    @just --list

# Start floci and the demo, wait until both answer, print the URL. Defaults
# to the pinned release, nothing but Docker needed; `just up source` builds
# choudoufu from this checkout's own code instead.
up mode="release":
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "{{mode}}" = "source" ]; then
      export BUILD_MODE=source
      export FORK_LABEL=$(cd ../.. && git describe --tags --always --dirty 2>/dev/null || echo dev)
      export RUNTIME_CHOUDOUFU_VERSION=local
      echo "building choudoufu from this checkout's source ($FORK_LABEL)..."
    else
      export BUILD_MODE=release
      export CHOUDOUFU_VERSION="{{pinned_version}}"
      export RUNTIME_CHOUDOUFU_VERSION="{{pinned_version}}"
      echo "using pinned release {{pinned_version}}..."
    fi
    {{compose}} up -d --build
    echo "waiting for the demo to answer..."
    for i in $(seq 1 60); do curl -fs -o /dev/null http://localhost:2718/ && break || sleep 2; done
    echo "" && echo "  ✓ live-mv demo:  http://localhost:2718" && echo "  ✓ floci:         inside the stack, account 000000000000" && echo ""

# Stop the stack, keep the provider cache.
down:
    {{compose}} down

# Wipe everything (containers, the emulator's state, the cache) and start
# fresh. `just reset source` to wipe and rebuild from source.
reset mode="release":
    {{compose}} down -v
    @just up {{mode}}

# Follow the demo's logs.
logs:
    {{compose}} logs -f demo

# Run the demo notebook on the host instead of in a container (for developing
# the UI), pointed at a floci you start yourself. Needs uv and a choudoufu binary.
dev:
    uv run --extra viz marimo run demo.py
