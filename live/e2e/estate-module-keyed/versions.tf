# ec2-module-keyed cohort — provider wiring, generated by tools/estate-gen
# -module-wrap -module-keys (issue #59, 59c), plus one line no generated
# cohort carries: the "live" block. Every other estates/<cohort> fixture is
# lint/identity fixture material only (see its own README's Gating section)
# and is never applied; this one is a real floci-driven estate
# (internal/live/lifecycle/module_keyed_live_test.go), so it needs the block
# that turns plain "choudoufu plan"/"choudoufu apply" stateless. The estate
# name matches wrapped/locals.tf's estate_tag exactly: the "live" block is
# what plain plan/apply read, and estate_tag is what each resource's own
# tofu-estate tag (in wrapped/ec2-module-keyed.tf) reads, and the two have
# to agree or the run would stamp one estate while planning against another.

terraform {
  required_version = ">= 1.5.0"

  live {
    estate = "ec2-module-keyed-cohort"
  }

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "= 6.58.0"
    }
  }
}

provider "aws" {
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  s3_use_path_style           = true
}
