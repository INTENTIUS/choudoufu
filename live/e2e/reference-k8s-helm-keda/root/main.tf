# reference-k8s-helm-keda (#1983): kedacore's keda chart 2.21.0 (app v2.21.0,
# Apache-2.0), rendered client-side by the hashicorp/helm provider's
# helm_template data source and applied as kubernetes_manifest blocks, the
# shape live/kubernetes/COMPATIBILITY.md recommends for a Helm chart and the
# one reference-k8s-helm-template took first (#1963). No helm_release: Helm
# never talks to the cluster here.
#
# The chart archive is fetched and checked against its sha256 by run.sh,
# which records the URL, the version and the digest, and copies it to
# charts/ beside this file in every working root. values.yaml carries the
# estate's deltas from the chart defaults, including the estate's own
# Deployment and ScaledObject, which the chart renders from extraObjects.
#
# Every document of the render is split out and yamldecoded INSIDE the
# for_each expression, keyed kind/namespace/name, so names the chart shares
# across kinds (keda-operator is a ServiceAccount, a ClusterRole, a
# ClusterRoleBinding, a Service and a Deployment) stay distinct instances,
# and the manifest is the element itself: `manifest = each.value` (#1962).
#
# The render's deltas that live here rather than in values.yaml:
#
# - kube_version, pinned, for the reason given on the data source.
# - two omitempty drops. A false plain bool, a zero plain int or an empty
#   plain string in a built-in kind is omitempty in the API's Go types, so
#   the server never stores it, it comes back null, and the provider
#   reports an inconsistent result after apply. This render carries two
#   such fields: `hostNetwork: false` on the three KEDA Deployments, and
#   `value: ""` on nine container env entries across them (WATCH_NAMESPACE,
#   WATCH_LABEL_SELECTOR, WATCH_LABEL_SELECTOR_FOR_TRIGGERAUTH and the two
#   TLS cipher lists; EnvVar.value is a plain string). Those lines are
#   dropped before yamldecode; an env entry without a value is what the
#   server stores. Its other false values in built-in kinds are *bool
#   fields the server keeps (allowPrivilegeEscalation), its other empty
#   strings are list elements (the core API group, "", in RBAC rules), and
#   it carries no hostIPC, hostPID, publishNotReadyAddresses or zero probe
#   delay. The CRDs are decoded as rendered.
# - no hook clause: the chart has no helm.sh/hook document and no cert-gen
#   Job. The operator mints its TLS at runtime (certificates.autoGenerated)
#   into the kedaorg-certs Secret, which nothing here declares, and patches
#   the CA into the APIService and the ValidatingWebhookConfiguration below.
#   The metrics apiserver and the webhook pods mount that Secret and wait in
#   ContainerCreating until the operator has written it.
#
# What KEDA does at runtime, which nothing here declares: from each
# ScaledObject the operator creates a HorizontalPodAutoscaler named
# keda-hpa-<name>, owned by the ScaledObject and carrying a copy of its
# labels, and that HPA then writes the target Deployment's replica count
# through the scale subresource. The operator also adds its finalizer
# (finalizer.keda.sh) and its scaledobject.keda.sh/name label to every
# ScaledObject.

data "helm_template" "keda" {
  name         = "rel"
  namespace    = "keda"
  chart        = "${path.module}/charts/keda-2.21.0.tgz"
  include_crds = true
  values       = [file("${path.module}/values.yaml")]

  # helm_template never asks the cluster, so without this the render assumes
  # Helm's default capabilities (Kubernetes v1.20.0) and the chart's own
  # kubeVersion constraint (>=v1.23.0-0) refuses it. Pinned rather than read
  # from the cluster so the render is the same on every kind node image.
  kube_version = "1.36.0"
}

resource "kubernetes_namespace_v1" "keda" {
  metadata {
    name = "keda"
  }
}

# The chart's six CRDs (keda.sh and eventing.keda.sh), pre-applied on their
# own at cold deploy (#1173, declared in live/gauntlet/estates.json),
# because a root cannot plan a CRD and an object of it in one pass and the
# render carries ScaledObjects.
resource "kubernetes_manifest" "crds" {
  for_each = {
    for o in [
      for d in split("\n---\n", data.helm_template.keda.manifest) : yamldecode(d)
      if length(regexall("(?m)^kind:", d)) > 0
    ] : "${o.kind}/${try(o.metadata.namespace, "")}/${o.metadata.name}" => o
    if o.kind == "CustomResourceDefinition"
  }
  manifest = each.value
}

# Everything else the chart renders except the Deployments and the
# ScaledObjects: ServiceAccounts, ClusterRoles and their bindings, a Role
# and two RoleBindings (one in kube-system), Services, the
# ValidatingWebhookConfiguration and the APIService that registers
# external.metrics.k8s.io with the aggregation layer, cluster-wide.
resource "kubernetes_manifest" "rest" {
  for_each = {
    for o in [
      for d in split("\n---\n", data.helm_template.keda.manifest) : yamldecode(replace(d, "/(?m)^[ ]*(hostNetwork: false|value: \"\")[ ]*$/", ""))
      if length(regexall("(?m)^kind:", d)) > 0
    ] : "${o.kind}/${try(o.metadata.namespace, "")}/${o.metadata.name}" => o
    if !contains(["CustomResourceDefinition", "Deployment", "ScaledObject"], o.kind)
  }
  manifest = each.value

  depends_on = [kubernetes_namespace_v1.keda, kubernetes_manifest.crds]
}

# The Deployments - KEDA's three and the estate's own scale targets from
# extraObjects - after the RBAC, the Services and the Role the operator
# needs to write its certificate Secret at start-up.
resource "kubernetes_manifest" "late" {
  for_each = {
    for o in [
      for d in split("\n---\n", data.helm_template.keda.manifest) : yamldecode(replace(d, "/(?m)^[ ]*(hostNetwork: false|value: \"\")[ ]*$/", ""))
      if length(regexall("(?m)^kind:", d)) > 0
    ] : "${o.kind}/${try(o.metadata.namespace, "")}/${o.metadata.name}" => o
    if o.kind == "Deployment"
  }
  manifest = each.value

  depends_on = [kubernetes_manifest.rest]
}

# The ScaledObjects, last, in a block of their own. The operator puts its
# finalizer on every ScaledObject and only the running operator takes it
# off, so a ScaledObject has to be destroyed while the keda-operator
# Deployment still exists. Destroy runs the blocks in reverse, so this
# block's depends_on on the Deployments is what orders it first; in the
# rest block it would be destroyed after them and hang on its finalizer.
# Going in after the Deployments also means each one's scale target exists
# when the admission webhook validates it.
resource "kubernetes_manifest" "scalers" {
  for_each = {
    for o in [
      for d in split("\n---\n", data.helm_template.keda.manifest) : yamldecode(d)
      if length(regexall("(?m)^kind:", d)) > 0
    ] : "${o.kind}/${try(o.metadata.namespace, "")}/${o.metadata.name}" => o
    if o.kind == "ScaledObject"
  }
  manifest = each.value

  depends_on = [kubernetes_manifest.late]
}
