# Supporting, not coverage - added only so aws_kms_key.storage's referring resources have a value to point at: generated by estate-gen from hashicorp/aws 6.59.0 and the identity table (internal/live/identity/table.go).
# overrides: doc example: deletion_window_in_days, description, enable_key_rotation
resource "aws_kms_key" "storage" {
  deletion_window_in_days = 20
  description             = "An example symmetric encryption KMS key"
  enable_key_rotation     = true
  tags = {
    tofu-estate  = local.estate_tag
    tofu-address = "aws_kms_key.storage"
  }
}

