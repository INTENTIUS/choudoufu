# Supporting, not coverage - added only so aws_kinesis_firehose_delivery_stream.connect-euc's referring resources have a value to point at: generated by estate-gen from hashicorp/aws 6.59.0 and the identity table (internal/live/identity/table.go).
# overrides: name coincidentally collides with aws_athena_data_catalog's own "name" identity argument in this cohort - see this file's data-plane batch header comment; destination is a required enum naming which optional *_configuration block the provider actually reads (validate: "expected destination to be one of [...]"), and the matching extended_s3_configuration block is itself optional in the schema while the provider requires it in practice once destination = "extended_s3"
resource "aws_kinesis_firehose_delivery_stream" "connect-euc" {
  name        = "tofu-connect-euc-cohort-firehose"
  destination = "extended_s3"
  extended_s3_configuration {
    bucket_arn = "arn:aws:s3:::tofu-connect-euc-cohort-firehose"
  }
  tags = {
    tofu-estate  = local.estate_tag
    tofu-address = "aws_kinesis_firehose_delivery_stream.connect-euc"
  }
}
