# Supporting, not coverage - added only so aws_ecr_repository.stragglers's referring resources have a value to point at: generated by estate-gen from hashicorp/aws 6.59.0 and the identity table (internal/live/identity/table.go).
# overrides: doc example: image_tag_mutability, image_scanning_configuration.scan_on_push
resource "aws_ecr_repository" "stragglers" {
  name                 = "tofu-stragglers-cohort-ecr-repository"
  image_tag_mutability = "MUTABLE"
  image_scanning_configuration {
    scan_on_push = true
  }
  tags = {
    tofu-estate  = local.estate_tag
    tofu-address = "aws_ecr_repository.stragglers"
  }
}
