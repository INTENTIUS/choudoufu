}

# Supporting, not coverage - added only so aws_ecs_task_definition.ecs-eks's referring resources have a value to point at: generated by estate-gen from hashicorp/aws 6.59.0 and the identity table (internal/live/identity/table.go).
# overrides: "container_definitions" is a required string the schema does not constrain, but the provider validates it is well-formed JSON (validate: "container_definitions ... contains an invalid JSON"); the generic placeholder string is not, same shape as aws_iam_role's own assume_role_policy override above
resource "aws_ecs_task_definition" "ecs-eks" {
  container_definitions = jsonencode([
    {
      name      = "app"
      image     = "nginx:latest"
      cpu       = 256
      memory    = 512
      essential = true
    }
  ])
  family = "placeholder"
  tags = {
    tofu-estate  = local.estate_tag
    tofu-address = "aws_ecs_task_definition.ecs-eks"
  }
}

# Supporting, not coverage - added only so aws_iam_role.ecs-eks's referring resources have a value to point at: generated by estate-gen from hashicorp/aws 6.59.0 and the identity table (internal/live/identity/table.go).
# overrides: schema requires "assume_role_policy" as a plain string, but the provider validates it is well-formed JSON (validate: "\"assume_role_policy\" contains an invalid JSON"); the generic string placeholder is not JSON
resource "aws_iam_role" "ecs-eks" {
  name = "tofu-ecs-eks-cohort-iam-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "ecs-eks.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
  tags = {
    tofu-estate  = local.estate_tag
    tofu-address = "aws_iam_role.ecs-eks"
  }
}
