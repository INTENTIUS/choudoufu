# Supporting, not coverage - added only so aws_dynamodb_table.ecs-eks's referring resources have a value to point at: generated by estate-gen from hashicorp/aws 6.59.0 and the identity table (internal/live/identity/table.go).
# overrides: doc example: billing_mode, hash_key, range_key, read_capacity, write_capacity, attribute.name, attribute.type, ttl.attribute_name, ttl.enabled, global_secondary_index.hash_key, global_secondary_index.name, global_secondary_index.non_key_attributes, global_secondary_index.projection_type, global_secondary_index.range_key, global_secondary_index.read_capacity, global_secondary_index.write_capacity
resource "aws_dynamodb_table" "ecs-eks" {
  name           = "tofu-ecs-eks-cohort-dynamodb-table"
  billing_mode   = "PROVISIONED"
  hash_key       = "UserId"
  range_key      = "GameTitle"
  read_capacity  = 20
  write_capacity = 20
  attribute {
    name = "UserId"
    type = "S"
  }
  ttl {
    attribute_name = "TimeToExist"
    enabled        = true
  }
  global_secondary_index {
    hash_key           = "GameTitle"
    name               = "GameTitleIndex"
    non_key_attributes = ["UserId"]
    projection_type    = "INCLUDE"
    range_key          = "TopScore"
    read_capacity      = 10
    write_capacity     = 10
  }
  tags = {
    tofu-estate  = local.estate_tag
    tofu-address = "aws_dynamodb_table.ecs-eks"
  }
}

# Supporting, not coverage - added only so aws_ecs_cluster.ecs-eks's referring resources have a value to point at: generated by estate-gen from hashicorp/aws 6.59.0 and the identity table (internal/live/identity/table.go).
