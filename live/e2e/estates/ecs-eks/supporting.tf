# Supporting, not coverage - added only so aws_dynamodb_table.ecs-eks's referring resources have a value to point at: generated by estate-gen from hashicorp/aws 6.59.0 and the identity table (internal/live/identity/table.go).
# overrides: the doc's own example sets billing_mode, hash_key, range_key, read_capacity, write_capacity, three "attribute" blocks (UserId, GameTitle, TopScore), a ttl block and a global_secondary_index block - previously reached entirely through seedFromExample with no override at all, but seedFromExample only ever lands a repeated block's first element (seed.go: "the generic pass renders exactly one instance, so element zero is the only answer"), so GameTitle and TopScore's own "attribute" blocks - both referenced by this table's own range_key and global_secondary_index - were never reachable that way; CreateTable 400s without a matching AttributeDefinition for each ("... does not have a corresponding entry in AttributeDefinitions"). A pre-existing, general gap in seedFromExample's repeated-block handling (confirmed against unmodified main), not specific to this type; reconstructed here in full rather than as a two-block patch, because adding any override for a type suppresses seedFromExample for that whole type (seed.go's own doc comment) - a partial override would have traded the rest of this body away
resource "aws_dynamodb_table" "ecs-eks" {
  name           = "tofu-ecs-eks-cohort-dynamodb-table"
  billing_mode   = "PROVISIONED"
  hash_key       = "UserId"
  range_key      = "GameTitle"
  read_capacity  = 20
  write_capacity = 20
  attribute {
    name = "UserId"
    type = "S"
  }
  attribute {
    name = "GameTitle"
    type = "S"
  }
  attribute {
    name = "TopScore"
    type = "N"
  }
  ttl {
    attribute_name = "TimeToExist"
    enabled        = true
  }
  global_secondary_index {
    hash_key           = "GameTitle"
    name               = "GameTitleIndex"
    non_key_attributes = ["UserId"]
    projection_type    = "INCLUDE"
    range_key          = "TopScore"
    read_capacity      = 10
    write_capacity     = 10
  }
  tags = {
    tofu-estate  = local.estate_tag
    tofu-address = "aws_dynamodb_table.ecs-eks"
  }
}

# Supporting, not coverage - added only so aws_ecs_cluster.ecs-eks's referring resources have a value to point at: generated by estate-gen from hashicorp/aws 6.59.0 and the identity table (internal/live/identity/table.go).
