# Supporting, not coverage - added only so aws_route53_zone.route53-cloudfront's referring resources have a value to point at: generated by estate-gen from hashicorp/aws 6.59.0 and the identity table (internal/live/identity/table.go).
# overrides: none
resource "aws_route53_zone" "route53-cloudfront" {
  name = "tofu-route53-cloudfront-cohort-route53-zone"
  tags = {
    tofu-estate  = local.estate_tag
    tofu-address = "aws_route53_zone.route53-cloudfront"
  }
}

# Supporting, not coverage - added only so aws_vpc.route53-cloudfront's referring resources have a value to point at: generated by estate-gen from hashicorp/aws 6.59.0 and the identity table (internal/live/identity/table.go).
