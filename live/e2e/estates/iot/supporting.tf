# Supporting, not coverage - added only so aws_acm_certificate.iot's referring resources have a value to point at: generated by estate-gen from hashicorp/aws 6.59.0 and the identity table (internal/live/identity/table.go).
# overrides: doc example: validation_method; cfn-required (live/registry-schema-facts.json): domain_name
resource "aws_acm_certificate" "iot" {
  validation_method = "DNS"
  domain_name       = "tofu-iot-cohort-acm-certificate"
  tags = {
    tofu-estate  = local.estate_tag
    tofu-address = "aws_acm_certificate.iot"
  }
}

# Supporting, not coverage - added only so aws_iam_role.iot's referring resources have a value to point at: generated by estate-gen from hashicorp/aws 6.59.0 and the identity table (internal/live/identity/table.go).
# overrides: schema requires "assume_role_policy" as a plain string, but the provider validates it is well-formed JSON (validate: "\"assume_role_policy\" contains an invalid JSON"); the generic string placeholder is not JSON
resource "aws_iam_role" "iot" {
  name = "tofu-iot-cohort-iam-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "iot.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
  tags = {
    tofu-estate  = local.estate_tag
    tofu-address = "aws_iam_role.iot"
  }
}

# Supporting, not coverage - added only so aws_vpc.iot's referring resources have a value to point at: generated by estate-gen from hashicorp/aws 6.59.0 and the identity table (internal/live/identity/table.go).
